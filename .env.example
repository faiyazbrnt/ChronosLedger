# ==============================================================================
# Database Configuration (Supabase PostgreSQL + Prisma)
# ==============================================================================
# Pooled connection string (port 6543, pgbouncer=true) used for application queries
# IMPORTANT: In serverless environments (Vercel), DO NOT set connection_limit=1.
# Concurrent queries (Promise.all, RSC layout, server actions) require connection_limit=10
# and pool_timeout=30 to avoid P2024 connection pool timeout errors.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"

# Direct connection string (port 5432) used for migrations and schema pushes
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Supabase Auth & Client Configuration
# ==============================================================================
# Public project URL found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Public anon/publishable key found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Base application URL used for email redirect confirmation links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
