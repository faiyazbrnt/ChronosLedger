# ==============================================================================
# Database Configuration (Supabase PostgreSQL + Prisma)
# ==============================================================================
# Pooled connection string (port 6543, pgbouncer=true) used for application queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) used for migrations and schema pushes
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Supabase Auth & Client Configuration
# ==============================================================================
# Public project URL found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Public anon/publishable key found in Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Base application URL used for email redirect confirmation links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
