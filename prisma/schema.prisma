// Prisma Schema for DTR & Budget Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  BILLS
  SHOPPING
  HEALTH
  ENTERTAINMENT
  OTHER
}

enum BudgetCycleType {
  WEEKLY
  MONTHLY
  SEMI_MONTHLY
}

model Profile {
  id         String     @id @db.Uuid // Matches auth.users.id
  email      String     @unique
  name       String?
  avatar     String?    @db.Text
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  settings     Settings?
  budgetConfig BudgetConfig?
  dtrEntries   DtrEntry[]
  dtrBreaks    DtrBreakEntry[]
  expenses     Expense[]
  allowances   WeeklyAllowance[]
  notifications Notification[]

  @@map("profiles")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Settings {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  currency            String   @default("PHP")
  renderedHoursTarget Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model DtrEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  workDate            DateTime @db.Date
  timeInMinutes       Int
  timeOutMinutes      Int?
  lunchMinutesApplied Int      @default(0) // Preserved for historical snapshot immutability
  note                String?
  activity            String?  @db.Text
  activityDescription String?  @db.Text
  remarks             String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  breaks   DtrBreakEntry[]
  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([userId, workDate])
  @@map("dtr_entries")
}

model DtrBreakEntry {
  id              String   @id @default(uuid()) @db.Uuid
  dtrEntryId      String   @db.Uuid
  userId          String   @db.Uuid
  category        String
  durationMinutes Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dtrEntry DtrEntry @relation(fields: [dtrEntryId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dtrEntryId])
  @@index([userId])
  @@map("dtr_break_entries")
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  spentOn     DateTime        @db.Date
  category    ExpenseCategory
  amountMinor Int
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentOn])
  @@map("expenses")
}

model BudgetConfig {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @unique @db.Uuid
  cycleType   BudgetCycleType @default(WEEKLY)
  amountMinor Int             @default(0)
  anchorDate  DateTime?       @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_configs")
}

model WeeklyAllowance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  weekStart   DateTime @db.Date // Monday
  amountMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_allowances")
}
